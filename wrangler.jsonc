{
  // Cloudflare Workers. 올리는 폴더는 dist/ 하나뿐 — tools/deploy.sh 가 사이트 파일만 골라 담습니다.
  // /admin 아래만 src/worker.js 가 로그인을 확인하고, 나머지는 정적 파일 그대로.
  // 관리자 비밀번호는 여기 없음: npx wrangler secret put ADMIN_PASSWORD
  "name": "2027-math10",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  // 버전별 미리보기 주소는 끔 (예전 버전이 따로 열리지 않게)
  "preview_urls": false,
  "vars": { "ADMIN_ID": "admin" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*"]
  }
}
